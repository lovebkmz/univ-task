WITH rev AS (
  SELECT c.city, c.customer_id, c.full_name,
         sum(oi.qty * oi.price) AS revenue
  FROM shop.customers c
  JOIN shop.orders o       USING (customer_id)
  JOIN shop.order_items oi USING (order_id)
  WHERE o.status <> 'cancelled'
  GROUP BY c.city, c.customer_id, c.full_name
),
ranked AS (
  SELECT *,
    RANK() OVER (PARTITION BY city ORDER BY revenue DESC) AS rnk,
    sum(revenue) OVER (PARTITION BY city)                 AS city_total,
    LEAD(revenue) OVER (PARTITION BY city ORDER BY revenue DESC) AS next_revenue
  FROM rev
)
SELECT city, full_name, revenue,
       round(100.0 * revenue / city_total, 2) AS share_pct,
       revenue - next_revenue                 AS gap_to_second
FROM ranked
WHERE rnk = 1
ORDER BY revenue DESC;



